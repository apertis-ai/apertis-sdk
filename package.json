{
  "name": "@apertis/ai-sdk-provider",
  "version": "3.0.0",
  "description": "Apertis AI provider for Vercel AI SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/apertis-ai/apertis-sdk"
  },
  "homepage": "https://apertis.ai?utm_source=apertis-sdk&utm_medium=npm&utm_campaign=ecosystem",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "keywords": [
    "ai",
    "apertis",
    "vercel",
    "ai-sdk",
    "llm",
    "openai",
    "anthropic"
  ]
}
